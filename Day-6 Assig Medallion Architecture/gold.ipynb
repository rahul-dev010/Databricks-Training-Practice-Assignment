   "source": [
    "CREATE VIEW IF NOT EXISTS cyntexa_dev.gold.product_gold AS\n",
    "SELECT\n",
    "product_id,\n",
    "SUM(quantity) AS total_quantity,\n",
    "SUM(total_amount) AS total_revenue\n",
    "FROM\n",
    "cyntexa_dev.silver.sales_silver\n",
    "GROUP BY\n",
    "product_id\n",
    "ORDER BY\n",
    "total_revenue DESC;"
   ]
  }
